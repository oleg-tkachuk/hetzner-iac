# Argo CD.
#
# What it reconciles is a stack config decision: set gitops:repoURL and the
# layer creates a root Application and the project that governs it; leave it
# unset and Argo CD is installed, reconciling nothing, and says so on every
# apply. This file configures the installation only.

global:
  # Quoted, so an unset domain stays an empty string. Unquoted it renders as
  # YAML null, and this chart interpolates that straight into argocd-cm:
  #
  #     domain: ""   ->  url: https://
  #     domain:      ->  url: https://%!s(<nil>)
  #
  # The server then runs with a nonsense URL in its configuration, never
  # becomes available, and Helm rolls the release back after its whole
  # timeout — seventeen minutes, with the cause nowhere in the output.
  domain: {{ printf "%q" .Domain }}

# The application controller is the component that actually reconciles. It is
# deliberately single-replica: sharding it needs configuration that only pays
# off with many applications.
controller:
  replicas: 1
  metrics:
    enabled: true
    # Off: nothing here installs the Prometheus operator CRDs.
    serviceMonitor:
      enabled: false

repoServer:
  replicas: {{ .Replicas }}
  metrics:
    enabled: true
    serviceMonitor:
      enabled: false

server:
  replicas: {{ .Replicas }}
  # TLS terminates at the ingress, so the API server speaks plaintext behind
  # it. Running TLS on both sides produces a redirect loop that is tedious to
  # diagnose.
  extraArgs:
    - --insecure
  metrics:
    enabled: true
    serviceMonitor:
      enabled: false
{{- if .Domain }}
  ingress:
    enabled: true
    # The class layers/40-ingress registers. An Ingress naming a class no
    # controller owns is accepted and then ignored.
    ingressClassName: {{ .IngressClass }}
    hostname: {{ .Domain }}
    annotations:
      cert-manager.io/cluster-issuer: {{ .Issuer }}
    tls: true
{{- end }}

applicationSet:
  replicas: {{ .Replicas }}

# Redis HA needs three nodes and buys availability for a cache that is rebuilt
# on start.
redis-ha:
  enabled: false

configs:
  params:
    server.insecure: true
