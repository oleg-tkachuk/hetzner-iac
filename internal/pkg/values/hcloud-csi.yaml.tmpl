# The Hetzner CSI driver.
#
# This file exists because the chart was installed on its defaults, which set
# no resources at all — every one of its eight containers ran unbounded on a
# node that also runs etcd and kube-apiserver.
#
# WHY THE KEYS LOOK LIKE THIS. The chart does not take one `resources` block
# per pod: it takes one per CONTAINER, under `controller.resources.<name>` and
# `node.resources.<name>`, and the names are the chart's own spelling
# (hcloudCSIDriver, not hcloud-csi-driver). Read out of `helm show values
# hcloud-csi --version 2.23.0` rather than remembered, because Helm accepts an
# unknown key, keeps its default, and says nothing — which is how a block like
# this gets written once and never takes effect.
#
# THE NUMBERS ARE MEASURED, on the three-node dev cluster with
# `kubectl top pods --containers`, taking the highest value across nodes:
#
#   hcloud-csi-driver (controller)    21Mi   2m
#   csi-attacher                       9Mi   2m
#   csi-provisioner                   12Mi   3m
#   csi-resizer                       10Mi   2m
#   liveness-probe (controller)       26Mi   3m
#   hcloud-csi-driver (node)          21Mi   2m
#   csi-node-driver-registrar         20Mi   1m
#   liveness-probe (node)             26Mi   3m
#
# Requests are rounded up from those; memory limits are several times them, so
# ordinary operation is never near one and a leak still cannot take the node.
#
# NO CPU LIMITS, here or anywhere else in this repository. A node has two
# cores and runs etcd beside these; CPU throttling would cost latency on the
# control plane to bound a cost that requests already bound by scheduling.

controller:
  # Creating and attaching volumes at all.
  priorityClassName: system-cluster-critical
  # THE CONTROLLER IS TOLD ITS LOCATION, NOT LEFT TO FIND IT.
  #
  # The chart's own words for the empty default: "If set the controller could
  # run anywhere. If left empty the controller needs to run on a hcloud node."
  # What that means in the driver is internal/app.GetServerLocation, and the
  # env var below is the FIRST thing it reads — set, and it returns
  # immediately; unset, and startup becomes: probe the metadata service at
  # 169.254.169.254, then look the node up by name through api.hetzner.cloud.
  #
  # Three reasons not to do that at startup:
  #
  #   - The API call needs DNS, and the CSI controller resolves through
  #     CoreDNS. The CCM, which calls the same API, sets `dnsPolicy: Default`
  #     and uses the node's resolvers instead — so the CSI controller is the
  #     one component in this layer whose start depends on cluster DNS being
  #     up, seconds after the CNI it also depends on was installed.
  #   - Its liveness probe allows 20 seconds (initialDelaySeconds 10, then
  #     failureThreshold 5 at periodSeconds 2). A slow lookup is a restart,
  #     and a restart loop is what was observed on the three-node cluster:
  #     CrashLoopBackOff with nothing logged after the driver's start line,
  #     which is exactly where the location lookup sits.
  #   - The chart's scheduling hint for all this is `preferred`, not
  #     `required`, so nothing guarantees the node it lands on is one where
  #     discovery works.
  #
  # The location is not a secret and not a guess: the cluster tier publishes
  # it, layer 60 already reads the same output for the Storage Box, and
  # chartsettings.HcloudCSIDefaultLocationKey names the key both this template
  # and its test use.
  hcloudVolumeDefaultLocation: {{ .Location }}

  resources:
    hcloudCSIDriver:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    csiAttacher:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    csiProvisioner:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    csiResizer:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    livenessProbe:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi

node:
  # A DaemonSet, and node-critical rather than cluster-critical because its
  # loss is a node-level failure: the plugin evicted here means every pod with
  # a volume on this node stays Pending, with nothing wrong on the volume.
  priorityClassName: system-node-critical
  resources:
    hcloudCSIDriver:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    csiNodeDriverRegistrar:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
    livenessProbe:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
