# Cilium, the CNI and the service dataplane.
#
# The cluster tier writes `proxy: {disabled: true}` into the Talos machine
# config, so kubeProxyReplacement below is not an optimisation: without it the
# cluster has no service dataplane at all and every ClusterIP blackholes.

ipam:
  # Addresses come from the Kubernetes node spec, which the CCM populates —
  # one source of truth for pod CIDRs rather than Cilium keeping its own.
  mode: kubernetes

# These three are the settings whose misspelling fails silently: Helm accepts
# an unknown key, the chart keeps its default, and the cluster starts wrong
# with nothing said. task charts:render-check asserts their effect on the
# rendered chart, and a test asserts they are still spelled this way.
kubeProxyReplacement: true
k8sServiceHost: {{ .APIHost }}
k8sServicePort: {{ .APIPort }}

# How pod traffic crosses nodes, from network.routingMode in the topology.
#
# native is the default: pod packets go to the private network's gateway, which
# routes them by the per-node routes the hcloud CCM programmes. One fewer
# header, and packet captures a human can read. The cluster tier puts the route
# to that gateway in every node's machine config — without it the packets match
# the default route and leave through the public interface.
#
# tunnel wraps them in VXLAN between node addresses instead. It needs nothing
# from the private network's routing, which makes it the answer when that
# routing is what is under suspicion. Costs ~50 bytes a packet and the MTU that
# goes with them.
routingMode: {{ .RoutingMode }}
ipv4NativeRoutingCIDR: {{ .PodCIDR }}

# NEVER true here, in either mode.
#
# It asks Cilium to route a peer's pod CIDR via that peer's address, and a
# Hetzner private network gives each server a /32 with only the gateway
# on-link. Cilium refuses and says exactly that:
#
#   Unable to install direct node route … route to destination 10.0.1.4
#   contains gateway 10.0.0.1, must be directly reachable
#
# It was true, and pod-to-pod across nodes therefore had no route at all for as
# long as the cluster had more than one node. Everything downstream followed:
# CoreDNS unreachable from another node, the CSI controller unable to resolve
# api.hetzner.cloud, its driver killed by its own liveness probe every twenty
# seconds. A single-node cluster hid all of it, because nothing crossed a node.
#
# The flag that error suggests, direct-routing-skip-unreachable, is not the fix
# — it only stops Cilium retrying a route that cannot work, and leaves the
# traffic with nowhere to go.
autoDirectNodeRoutes: false
endpointRoutes:
  enabled: true
bpf:
  masquerade: true
enableIPv4Masquerade: true
enableIPv6Masquerade: false
ipv6:
  enabled: false
loadBalancer:
  algorithm: maglev
socketLB:
  hostNamespaceOnly: true

# externalIPs, nodePort and hostPort are deliberately absent, and it took
# reading the chart to know that. This file set `enabled: true` on all three;
# Cilium 1.15 read them, 1.20 does not — they are in neither its values.yaml
# nor its templates, so Helm accepted three keys and ignored them.
#
# Nothing was lost by that, which is the uncomfortable half: with
# kubeProxyReplacement on, the agent serves NodePort, ExternalIPs and HostPort
# itself, and the rendered configmap carries no per-feature flag to set. The
# lines were doing nothing either way, and a value that does nothing is worse
# than no value — it reads as the reason a feature works.

# Talos mounts the cgroup filesystem itself and runs a read-only root, so
# Cilium must not try to mount it, and must be granted the capabilities it
# would otherwise take by running fully privileged.
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup
securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

# Resources. Requests are measured, limits are memory-only.
#
# Measured on the three-node dev cluster with `kubectl top pods
# --containers`, highest value across nodes. Requests round those up; memory
# limits sit several times above, so ordinary operation is never near one and a
# leak still cannot take a node that also runs etcd and kube-apiserver.
#
# NO CPU LIMITS, here or anywhere in this repository. A node has two cores and
# runs etcd beside these: throttling would cost control-plane latency to bound
# something requests already bound by scheduling.

# The agent, on every node. 367Mi and 46m measured — the largest chart-managed
# consumer in the cluster, and the one this policy exists for.
#
# The limit is deliberate and has a cost worth knowing: exceed 768Mi and the
# agent is OOMKilled, which restarts the CNI on that node. Cilium survives an
# agent restart — the datapath stays in BPF — and the alternative is an agent
# that grows until it takes etcd with it. 768Mi is 2.1x what it measured.
resources:
  requests:
    cpu: 100m
    memory: 384Mi
  limits:
    memory: 768Mi

# 55Mi and 3m measured, also on every node.
envoy:
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      memory: 192Mi

operator:
  # Two replicas so reconciliation of Cilium's own custom resources survives a
  # node failure — but only where two can run: each binds a host port, so on a
  # single-node cluster the second stays Pending for ever.
  replicas: {{ .OperatorReplicas }}
  prometheus:
    enabled: true
    # Off: nothing here installs the Prometheus operator CRDs — observability
    # is deployed through Argo CD — so this would be a kind that does not
    # exist, and the layer would fail on a cluster without it.
    serviceMonitor:
      enabled: false
  # 47Mi and 10m measured.
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      memory: 192Mi

prometheus:
  enabled: true
  serviceMonitor:
    enabled: false

hubble:
  enabled: true
  relay:
    enabled: true
    # 12Mi and 1m measured.
    resources:
      requests:
        cpu: 10m
        memory: 32Mi
      limits:
        memory: 128Mi
  ui:
    enabled: true
    backend:
      # 59Mi and 1m measured.
      resources:
        requests:
          cpu: 10m
          memory: 64Mi
        limits:
          memory: 192Mi
    frontend:
      # 10Mi and 1m measured.
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          memory: 128Mi
  metrics:
    enabled:
      - dns
      - drop
      - tcp
      - flow
      - port-distribution
      - icmp
    serviceMonitor:
      enabled: false
