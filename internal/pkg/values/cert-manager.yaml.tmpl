# cert-manager.

# One key for the controller, the webhook and the cainjector — the chart's own
# spelling. The webhook sits in the admission path for every Certificate, so
# losing it stops renewal with nothing said; that failure arrives ninety days
# later, as an expired certificate.
global:
  priorityClassName: system-cluster-critical

crds:
  # CRDs come with the release. Managing them separately is right when several
  # things install cert-manager; this cluster has one.
  enabled: true
  # Leave them behind on uninstall. Removing the CRDs deletes every
  # Certificate and Issuer in the cluster — a far larger action than
  # uninstalling a chart, and not one an uninstall should imply.
  keep: true

prometheus:
  enabled: true
  # Off: nothing here installs the Prometheus operator CRDs — observability is
  # deployed through Argo CD — so this would be a kind that does not exist.
  servicemonitor:
    enabled: false

# Resources. Requests are measured, limits are memory-only.
#
# Measured on the three-node dev cluster with `kubectl top pods
# --containers`: controller 66Mi/1m, cainjector 50Mi/2m, webhook 9Mi/1m.
#
# NO CPU LIMITS, here or anywhere in this repository. A node has two cores and
# runs etcd beside these: throttling would cost control-plane latency to bound
# something requests already bound by scheduling.
#
# startupapicheck is left on the chart's defaults on purpose. It is a Helm hook
# Job that makes one API call and is deleted when it succeeds, so there is
# nothing to measure and nothing for a limit to protect the node from.

# The controller.
resources:
  requests:
    cpu: 10m
    memory: 96Mi
  limits:
    memory: 256Mi

cainjector:
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 192Mi

webhook:
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      memory: 128Mi
