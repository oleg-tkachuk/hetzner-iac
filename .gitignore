# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Internal design docs — kept out of the public repository (temporary)
docs/

# Pulumi
Pulumi.*.yaml.bak
.pulumi/

# Build output. Pulumi's go language host compiles each layer to a stable
# path under here so repeated previews skip the link step.
.cache/

# `go build ./...` drops a binary named after each main package into the
# working directory. These collide with the tools/ directory names, so a
# stray build leaves an 10 MB executable sitting in the repository root.
/charts
/topology

# Task. The remote lock is the exception and is committed on purpose: it pins
# the CONTENT behind the `?ref=vX.Y.Z` tag, so a moved tag stops the build
# instead of silently changing it. Refresh deliberately with `task --download`.
.task/*
!.task/remote/
.task/remote/*
!.task/remote/*.checksum

# Cluster credentials produced by `task cluster:kubeconfig` / `cluster:talosconfig`
kubeconfig
talosconfig
*.kubeconfig

# Local etcd snapshots
.backups/

# `go build ./...` drops a binary named after each main package into the
# working directory, and those names collide with the tools/ and layers/
# directory names — a stray build otherwise leaves an executable in the
# repository root. The layer binaries are the big ones: 52 MB each, and one
# was committed and pushed before this line existed.
/charts
/topology
/[0-9][0-9]-*

# Local-only lefthook overrides. Gates that belong to a working copy rather
# than to the project; lefthook merges the file automatically when present.
lefthook-local.yml

# Development cluster topology. Kept local: its adminCIDRs holds the
# operator's real egress address, and this repository is public.
infra/cluster/cluster.dev.yaml
