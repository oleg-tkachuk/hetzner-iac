# Traefik, behind a Hetzner load balancer that Pulumi owns.
#
# The load balancer is NOT asked for here, and that is the change. A Service of
# type LoadBalancer hands the job to the hcloud cloud controller manager, which
# cost two things, both measured: the load balancer was invisible to
# `plan` and `destroy` and appeared only in the bill, and the CCM refused to
# make any node a target — Talos labels every control-plane node
# node.kubernetes.io/exclude-from-external-load-balancers, this cluster is
# three of those, and the result was an address with no targets behind it.
#
# So this Service is a NodePort and layers/40-ingress creates the load balancer
# through the Hetzner provider, selecting its targets by cluster label — a
# Hetzner concept that knows nothing about that Kubernetes label.

deployment:
  # Two, so losing one node does not take ingress with it.
  replicas: {{ .Replicas }}

service:
  spec:
    # NodePort, not LoadBalancer: nothing should ask the CCM for a load
    # balancer that Pulumi already manages. Both would then reconcile one
    # object.
    type: NodePort
    # Local keeps the client address usable end to end by avoiding the extra
    # hop that would rewrite it. It is also what makes the load balancer's
    # health check meaningful: a node with no Traefik pod does not answer on
    # the node port, so it fails the check and stops receiving requests.
    externalTrafficPolicy: Local

# The other half of the PROXY protocol pair. Traefik accepts the header only
# from addresses it is told to trust, and its default is to trust nobody —
# which rejects every connection arriving through the load balancer.
#
# The range is the node subnet the cluster tier publishes, because the load
# balancer reaches the nodes privately. A wider range would accept a spoofed
# header from any pod.
#
# Both entry points need it. Forgetting websecure breaks only HTTPS, which is
# the harder failure to notice.
#
# The node ports are PINNED. Kubernetes would otherwise allocate them from
# 30000-32767, and a load balancer Pulumi creates cannot forward to a number
# it learns afterwards. pkg/hetzner names both and this template interpolates
# the same two constants, so the pair cannot drift — a mismatch would leave the
# load balancer health-checking a closed port and reporting every target
# unhealthy with nothing else wrong.
ports:
  web:
    nodePort: {{ .NodePortHTTP }}
    proxyProtocol:
      trustedIPs:
        - {{ .NodeSubnet }}
  websecure:
    nodePort: {{ .NodePortHTTPS }}
    proxyProtocol:
      trustedIPs:
        - {{ .NodeSubnet }}

# No forwardedHeaders trust list, deliberately. The client address arrives in
# the PROXY header; trusting X-Forwarded-* as well would accept a spoofed one.
# Traefik trusts nobody by default, so this is a default kept rather than a
# value set.

# No api.insecure either: that serves the dashboard without authentication.
# Exposing it is an IngressRoute plus an auth middleware, and belongs with
# whatever decides who may see it.

# Spread across nodes rather than merely counted. The selector is the label
# the chart stamps on its pods — a selector matching nothing is accepted by
# Kubernetes and does nothing at all.
topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: kubernetes.io/hostname
    whenUnsatisfiable: ScheduleAnyway
    labelSelector:
      matchLabels:
        app.kubernetes.io/name: traefik

podDisruptionBudget:
  enabled: true
  minAvailable: 1
