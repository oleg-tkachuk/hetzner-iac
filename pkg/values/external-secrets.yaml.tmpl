# External Secrets Operator.
#
# Deployed and, today, managing nothing: the cluster has no SecretStore. See
# the backlog — the blocker is which secret backend, not the work.

installCRDs: true

# Off: nothing here installs the Prometheus operator CRDs — observability
# is deployed through Argo CD — so this would be a kind that does not exist.
serviceMonitor:
  enabled: false

# Resources. Requests are measured, limits are memory-only.
#
# Measured on the three-node dev cluster on 2026-09-14 with `kubectl top pods
# --containers`, highest value across nodes. Requests round those up; memory
# limits sit several times above, so ordinary operation is never near one and a
# leak still cannot take a node that also runs etcd and kube-apiserver.
#
# NO CPU LIMITS, here or anywhere in this repository. A node has two cores and
# runs etcd beside these: throttling would cost control-plane latency to bound
# something requests already bound by scheduling.

# Measured: external-secrets 26Mi/3m, webhook 26Mi/5m, certController 37Mi/2m.
resources:
  requests:
    cpu: 10m
    memory: 64Mi
  limits:
    memory: 192Mi

webhook:
  create: true
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 192Mi

certController:
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      memory: 192Mi
