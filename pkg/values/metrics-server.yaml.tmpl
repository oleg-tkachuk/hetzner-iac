# metrics-server.

args:
  # Talos nodes are addressed on the private network and their kubelet
  # certificates carry the internal address. The chart's default preference
  # order tries the hostname first, which does not resolve here — so
  # metrics-server starts, every scrape fails, and the horizontal pod
  # autoscaler is silently blind.
  #
  # task charts:render-check asserts this reaches the rendered arguments.
  - {{ .AddressTypes }}

# Two replicas so a node failure does not take metrics — and with them the
# autoscaler — down.
replicas: {{ .Replicas }}

podDisruptionBudget:
  enabled: true
  minAvailable: 1

# Resources. Requests are measured, limits are memory-only.
#
# Measured on the three-node dev cluster on 2026-09-14 with `kubectl top pods
# --containers`, highest value across nodes. Requests round those up; memory
# limits sit several times above, so ordinary operation is never near one and a
# leak still cannot take a node that also runs etcd and kube-apiserver.
#
# NO CPU LIMITS, here or anywhere in this repository. A node has two cores and
# runs etcd beside these: throttling would cost control-plane latency to bound
# something requests already bound by scheduling.

# 25Mi and 8m measured. Its memory grows with the number of pods it scrapes,
# which on this cluster is a few dozen.
resources:
  requests:
    cpu: 25m
    memory: 64Mi
  limits:
    memory: 192Mi
